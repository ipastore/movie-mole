# --- secrets & credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
id_rsa*
id_ed25519*
credentials*
secrets*

# --- VPS / deploy config (holds host, ports, neo4j auth) ---
docker/.env
docker/*.env
docker/secrets/
deploy/
*.retry
letsencrypt/
certbot/
nginx/ssl/

# --- datasets: multi-GB, never commit ---
# data/* (not data/) so the negations below can re-include specific paths --
# git cannot re-include a file whose parent directory is excluded.
ingestion/data/
data/*
!data/samples/
!data/METADATA.md
!data/MANIFEST.md
ml-latest*/
ml-25m/
data/imdb/title.*.tsv*
data/imdb/name.basics.tsv*
*.tsv.gz
*.csv.gz
*.zip

# --- neo4j ---
neo4j/data/
neo4j/logs/
neo4j/import/
neo4j/plugins/
*.dump

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.env.venv
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- node / frontend ---
node_modules/
dist/
.vite/
*.log
npm-debug.log*

# --- claude code: local-only settings ---
.claude/settings.local.json

# --- proprietary: Cronolix brand kit, unrelated to this project ---
.claude/skills/cronolix-design/

# --- os ---
.DS_Store
Thumbs.db
